# ============================================================
# Water Quality Monitoring Platform - Environment Variables
# ============================================================
# Copy this file to `.env` (server) and `.env.local` (client)
# and fill in the values. Never commit real keys to git.
# ------------------------------------------------------------

# ----------------------------
# Server (server/.env)
# ----------------------------

# Port the Express HTTP/WebSocket server listens on
PORT=3001

# Port for the built-in Aedes MQTT broker (IoT ingestion)
MQTT_PORT=1883

# Shared secret for device telemetry ingestion (x-api-key header)
# Used by firmware + scripts/iot_fleet_simulator.js
API_KEY=wq_device_token_demo_2026

# ----------------------------
# Client (client/.env.local) — Vite env vars
# ----------------------------

# Map tile provider API key (prefix with VITE_ to expose to browser)
# Provider produced this key for raster map tiles. Referenced in
# client/src/components/authority/StationMap.jsx if you enable a
# key-requiring tile provider (currently keyless CARTO by default).
VITE_MAP_API_KEY=

# Tile URL template — set if you switch to a keyed tile provider
# (e.g., MapTiler, Mapbox). Leave commented to use the keyless
# CARTO basemap by default.
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/basic-v2/{z}/{x}/{y}.png?key=
